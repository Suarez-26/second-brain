# ========================================================
# Second Brain & WhatsApp Bot - Configuración de Entorno
# Copia este archivo como .env y reemplaza los valores de ejemplo
# ========================================================

# --- Kapso API (Gestor de WhatsApp Cloud API) ---
KAPSO_API_BASE_URL=https://api.kapso.ai
KAPSO_API_KEY=tu_kapso_api_key_aqui

# --- Google Gemini AI (Procesamiento conversacional y multimodal) ---
GEMINI_API_KEY=tu_gemini_api_key_aqui
GEMINI_MODELOS=gemini-3-flash-preview,gemini-3.5-flash,gemini-3.6-flash,gemini-flash-lite-latest
GEMINI_TIMEOUT_TOTAL=40

# --- WhatsApp Cloud API Oficial (Meta) ---
WHATSAPP_PHONE_NUMBER_ID=tu_phone_number_id_aqui
WHATSAPP_ACCESS_TOKEN=tu_meta_whatsapp_access_token_aqui
WHATSAPP_VERIFY_TOKEN=tu_token_secreto_para_el_webhook

# --- Configuración Operativa y Administrador ---
# Números de WhatsApp autorizados como administradores (separados por coma)
ADMIN_PHONE_NUMBER=573001234567
ADMIN_NOMBRE=Administrador
FIRMA_EXTERNOS=Equipo Second Brain

# --- Transcripción Local de Audio (faster-whisper) ---
# Modelos disponibles: tiny, base, small, medium (procesamiento en CPU con int8)
WHISPER_MODELO=base

# --- Ruta opcional al ejecutable de Python ---
# SECOND_BRAIN_PYTHON=python
