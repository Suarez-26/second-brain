    "dDurationMs": 6400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "cómo superar\nesos mitos"
    } ]
  }, {
    "tStartMs": 140920,
    "dDurationMs": 6360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "de\ny esas fuerzas de de su unión en el"
