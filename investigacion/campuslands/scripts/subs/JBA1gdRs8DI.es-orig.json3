    "segs": [ {
      "utf8": "Eso implica\nsentarnos a reconocernos el uno al otro,"
    } ]
  }, {
    "tStartMs": 408360,
    "dDurationMs": 9800,
    "wWinId": 1,
    "segs": [ {
      "utf8": "a escucharnos\ny ahí yo creo que tenemos que eh avanzar"
    } ]
  }, {
    "tStartMs": 415360,
    "dDurationMs": 6760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "con el propósito de de generar confianza\nentre los diferentes actores."
    } ]
  }, {
    "tStartMs": 420160,
    "dDurationMs": 6560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Se me viene a la mente que muchas veces\nen el en este mundo tan cambiante o este"
