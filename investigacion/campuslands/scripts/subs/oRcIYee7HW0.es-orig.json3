    } ]
  }, {
    "tStartMs": 85119,
    "dDurationMs": 8000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "pensar que no hacer o o dejar de hacer\nlo que tenía que haber hecho cuando salí",
