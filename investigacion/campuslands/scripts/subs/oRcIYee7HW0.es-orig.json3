    } ]
  }, {
    "tStartMs": 81240,
    "dDurationMs": 6640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "futuro que pueda ayudar a mi familia.\nPuedo por fin quitarme la carga de",
