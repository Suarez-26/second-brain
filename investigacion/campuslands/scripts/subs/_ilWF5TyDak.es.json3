      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1974720,
    "dDurationMs": 6120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "llena de principios y valores que fueron\naprendidos de su abuelita y de su madre,",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1978919,
    "dDurationMs": 4880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "quien le tocó salir a trabajar para\nconseguir el sustento para él y su",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1982720,
    "dDurationMs": 7199,
    "wWinId": 1,
    "segs": [ {
      "utf8": "familia.\nSon principios que me enseñaron desde",
