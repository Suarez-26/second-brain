    "wWinId": 1,
    "segs": [ {
      "utf8": "extraordinario. Nos vemos en una próxima\noportunidad para que sigamos juntos",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3274960,
    "dDurationMs": 5720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "descubriendo por qué todavía podemos\ncreer en la gente y en el mundo. ¿Por",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3279040,
    "dDurationMs": 6319,
    "wWinId": 1,
    "segs": [ {
      "utf8": "qué siempre se puede tener un mundo\nmejor y contar mejores historias? Porque",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3283480,
    "dDurationMs": 7040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "aquí lo que nos une son las historias,\npero contadas de otra manera. Hasta",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3287520,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "pronto.",
      "acAsrConf": 0
    } ]
  }, {
