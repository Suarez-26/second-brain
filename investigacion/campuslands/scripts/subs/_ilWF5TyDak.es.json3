    } ]
  }, {
    "tStartMs": 1678480,
    "dDurationMs": 10880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Él quedó con el apartamento que que\ntenían sus papás y por el consumo",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1686279,
    "dDurationMs": 11000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "comenzó a deteriorarse tanto él como el\napartamento. ya acabó con todo lo que",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1693080,
    "dDurationMs": 9920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "quedó ahí dentro del inmueble y ingresa\npersonas que son consumidoras y una de",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1700640,
    "dDurationMs": 7440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "esas personas, según lo que me informó\nfue que le leonó el dedo. Observando la",
