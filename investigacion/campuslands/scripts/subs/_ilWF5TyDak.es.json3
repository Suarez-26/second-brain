      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1621960,
    "dDurationMs": 8959,
    "wWinId": 1,
    "segs": [ {
      "utf8": "vigilar las calles? hacía\naproximadamente un año, un año mostrar",
