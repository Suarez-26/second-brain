    } ]
  }, {
    "tStartMs": 1898960,
    "dDurationMs": 4959,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Bueno,\nAndrés Cortés, más que comerciante y",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1901960,
    "dDurationMs": 5920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "administrador del restaurante, se ha\nconvertido en el mejor amigo del",
