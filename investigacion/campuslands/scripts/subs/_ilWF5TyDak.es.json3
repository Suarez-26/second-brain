    } ]
  }, {
    "tStartMs": 1583480,
    "dDurationMs": 4240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Acabo durmiendo acá, mi porque no puedo\nver para atrás.",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1585919,
    "dDurationMs": 6961,
    "wWinId": 1,
    "segs": [ {
      "utf8": "¿En dónde? Yo sé. Se acuerda que el\npersonaje que que sacó eh el que lo sacó",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1591000,
    "dDurationMs": 6039,
    "wWinId": 1,
    "segs": [ {
      "utf8": "corriendo, ¿se acuerda el que no sacó\ncon cuchillo? Brian otra vez volvó y me",
