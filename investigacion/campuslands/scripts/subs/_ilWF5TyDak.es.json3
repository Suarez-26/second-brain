    } ]
  }, {
    "tStartMs": 1742240,
    "dDurationMs": 9279,
    "wWinId": 1,
    "segs": [ {
      "utf8": "juventud, eso, está ahí en la calle y yo\nquiero quiero brindarle esa opción,",
