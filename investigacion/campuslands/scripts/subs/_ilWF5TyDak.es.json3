    "wWinId": 1,
    "segs": [ {
      "utf8": "[Música]"
    }, {
      "utf8": "\nBuenas.",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1579679,
    "dDurationMs": 5161,
    "wWinId": 1,
    "segs": [ {
      "utf8": "¿Qué más, mi negro?\n¿Cómo va?",
