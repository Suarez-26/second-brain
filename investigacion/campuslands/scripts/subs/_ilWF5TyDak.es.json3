    } ]
  }, {
    "tStartMs": 1808200,
    "dDurationMs": 4839,
    "wWinId": 1,
    "segs": [ {
      "utf8": "dormir en mi casa. Nadie me tiró\ncuchillo. Me tocó fue correr.",
