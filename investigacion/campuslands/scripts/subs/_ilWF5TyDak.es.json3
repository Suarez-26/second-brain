      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1789240,
    "dDurationMs": 6439,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Pero espere, papi. Ya fue el la\npatrulla. Ya no.",
