    } ]
  }, {
    "tStartMs": 1714080,
    "dDurationMs": 6079,
    "wWinId": 1,
    "segs": [ {
      "utf8": "presenta allá en el inmueble del joven.\nY es que detrás de cada ser humano que",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1718480,
    "dDurationMs": 6360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "este patrullero ayuda, hay una historia\nque merece ser escuchada, una carga que",
