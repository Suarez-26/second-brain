    } ]
  }, {
    "tStartMs": 1595880,
    "dDurationMs": 4960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "lastimó.\n¿Cuál es ese Bran?",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1598039,
    "dDurationMs": 7921,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Bran el monito.\nPues es del Carva.",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1602159,
    "dDurationMs": 9361,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Oh, aquí va de la fábrica de papas.\n¿Qué le pasó en el dedo?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1608520,
    "dDurationMs": 6159,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Pero venga.\nYa almorzó al guito, negro. Le provoca",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1613880,
    "dDurationMs": 6039,
    "wWinId": 1,
    "segs": [ {
      "utf8": "papi.\nSí, serio. Mire de corazón.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1618200,
    "dDurationMs": 5280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Andrés, ¿y cuándo empezó a notar que\nquería hacer algo más que simplemente",
