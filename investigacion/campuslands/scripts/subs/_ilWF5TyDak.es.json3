    } ]
  }, {
    "tStartMs": 1748720,
    "dDurationMs": 9079,
    "wWinId": 1,
    "segs": [ {
      "utf8": "quiero brindarle esa oportunidad de que\nqué quiere, estoy aquí para ayudarlo.",
