    } ]
  }, {
    "tStartMs": 1986880,
    "dDurationMs": 11600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "pequeño, tanto mi abuelita que fue la\nque me crió mientras mi mamita se venía",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1992799,
    "dDurationMs": 11401,
    "wWinId": 1,
    "segs": [ {
      "utf8": "de del pueblo aquí a la ciudad y durante\nsu estadía pasaron unos años para que",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2001279,
    "dDurationMs": 7161,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ella se ubicara bien y poderme traer.\nElla fue la que me creó, mi abuelita y",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2006760,
    "dDurationMs": 8480,
    "wWinId": 1,
    "segs": [ {
