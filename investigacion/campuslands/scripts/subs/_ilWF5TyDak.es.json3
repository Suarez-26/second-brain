    } ]
  }, {
    "tStartMs": 1865799,
    "dDurationMs": 5561,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Pero él no trabaja solo. Gracias al\napoyo de su tocayo, Andrés, que tiene un",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1869519,
    "dDurationMs": 5961,
    "wWinId": 1,
    "segs": [ {
