      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1633520,
    "dDurationMs": 11759,
    "wWinId": 1,
    "segs": [ {
      "utf8": "soy una persona, soy un ser humano que\nvila y trabajo por la tranquilidad y la",
