    } ]
  }, {
    "tStartMs": 1951639,
    "dDurationMs": 6481,
    "wWinId": 1,
    "segs": [ {
      "utf8": "será que pueda apoyarme y pues\nobviamente si yo estoy, voy y lo apoyo.",
