      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1533039,
    "dDurationMs": 5841,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Algo que casi no se ve hoy en día, pero\nél lo hace posible por su propia",
