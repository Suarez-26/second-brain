    } ]
  }, {
    "tStartMs": 1642200,
    "dDurationMs": 7079,
    "wWinId": 1,
    "segs": [ {
      "utf8": "convivencia y la seguridad de todos los\nresidentes",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1646880,
    "dDurationMs": 6960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "de aquí de la zona donde yo laboro. Y\nquise demostrar que nosotros también",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1651279,
    "dDurationMs": 7041,
    "wWinId": 1,
    "segs": [ {
      "utf8": "somos buenos. Como hay tantas cosas\nnegativas, entonces publiquemos las",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1655320,
    "dDurationMs": 6520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "cosas buenas. Y esto es una cosa buena,\nes abordar a estas personas que está en",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1660600,
    "dDurationMs": 5679,
    "wWinId": 1,
    "segs": [ {
      "utf8": "condición de calle.\nNos cuenta que no espera reconocimiento",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1663760,
    "dDurationMs": 6240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ni recompensa alguna. Su motor es la\nsatisfacción de saber que con cada",
