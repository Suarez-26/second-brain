    } ]
  }, {
    "tStartMs": 1731880,
    "dDurationMs": 7919,
    "wWinId": 1,
    "segs": [ {
      "utf8": "el indiferente rechazo de la sociedad.\nYo no soy para juzgar, yo no soy para",
