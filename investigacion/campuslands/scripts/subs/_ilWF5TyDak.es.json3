  }, {
    "tStartMs": 1793279,
    "dDurationMs": 6721,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Esp, hágame un favor. Llame a Kilian que\nllegue acá. Mire lo que conlleva en",
