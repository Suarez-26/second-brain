    } ]
  }, {
    "tStartMs": 1905480,
    "dDurationMs": 6240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "patrullero Chavarro, ese cómplice que le\ngraba sus videos para difundir a través",
