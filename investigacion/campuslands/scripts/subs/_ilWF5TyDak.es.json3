    } ]
  }, {
    "tStartMs": 2021399,
    "dDurationMs": 6280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Y aunque nació en Bogotá, se creó en el\nmunicipio del Cocú y Boyacá, rodeado de",
