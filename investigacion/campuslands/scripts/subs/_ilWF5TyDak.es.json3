    } ]
  }, {
    "tStartMs": 1933690,
    "dDurationMs": 15750,
    "wWinId": 1,
    "segs": [ {
      "utf8": "[Música]"
    }, {
      "utf8": "\nalgún momento me llama, a veces yo voy y",
