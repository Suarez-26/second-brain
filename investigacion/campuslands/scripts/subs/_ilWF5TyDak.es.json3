    } ]
  }, {
    "tStartMs": 1525960,
    "dDurationMs": 4920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "de la esencia de la Policía Nacional,\nestar con la comunidad.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1529080,
    "dDurationMs": 6120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "¿Cómo está, papi?\nBien, gracias.",
