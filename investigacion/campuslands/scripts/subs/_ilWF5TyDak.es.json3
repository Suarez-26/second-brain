    } ]
  }, {
    "tStartMs": 1667919,
    "dDurationMs": 7561,
    "wWinId": 1,
    "segs": [ {
      "utf8": "acción transforma la vida y construye\nesperanza para quienes más lo necesitan.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1673000,
    "dDurationMs": 8880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Según lo que él me informa,\nél perdió sus familiares.",
