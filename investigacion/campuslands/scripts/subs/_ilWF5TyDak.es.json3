    } ]
  }, {
    "tStartMs": 1811159,
    "dDurationMs": 4520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Ya, ya, ya. Pues cálmese.\nYo estoy la mano y todo. No,",
